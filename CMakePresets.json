{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (MSVC x64, Qt app + CLI + tests)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (MSVC x64)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "core",
      "inherits": "base",
      "displayName": "Portable core + tests only (no Qt, no Windows APIs)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "STICKYAIM_CORE_ONLY": "ON" }
    },
    {
      "name": "package",
      "inherits": "base",
      "displayName": "Release build used for the installer (separate folder from build/release)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "core", "configurePreset": "core" },
    { "name": "package", "configurePreset": "package" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "package", "configurePreset": "package", "output": { "outputOnFailure": true } }
  ]
}
